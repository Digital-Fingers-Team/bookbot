# API
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aradobotd
CLIENT_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Heyzine: Client ID is required for PDF conversion. API key is only needed
# for optional management operations (list/update/delete/details).
HEYZINE_CLIENT_ID=
HEYZINE_API_KEY=
ADMIN_API_KEY=change-me
AUTH_JWT_SECRET=change-me-aradobot-auth-secret
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=qwen/qwen3-8b
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536

# Local LLM option (Ollama, LM Studio, or vLLM). Uncomment/use these to leave
# the online chat API: set LLM_PROVIDER=local and start your local server.
# Ollama example: `ollama serve` then `ollama pull qwen2.5:7b`.
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=qwen2.5:7b
# Set false only when the local server rejects response_format/json mode.
# LOCAL_LLM_JSON_MODE=true

# Optional fully local embeddings. This is independent from chat generation.
# Uncomment EMBEDDING_PROVIDER=local only after creating a MongoDB vector index
# with LOCAL_EMBEDDING_DIMENSIONS and re-embedding existing book chunks.
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_EMBEDDING_API_KEY=
# LOCAL_EMBEDDING_MODEL=nomic-embed-text
# LOCAL_EMBEDDING_DIMENSIONS=768

# OCR fallback (reads rendered page images when the PDF text layer is broken)
OCR_ENABLED=true
# auto = cloud vision model, falling back to local tesseract when out of credits.
# openrouter = cloud only. local = offline tesseract only (free, no key needed).
OCR_PROVIDER=auto
OCR_LOCAL_LANGS=ara+eng
# Local tesseract drops words below this confidence (0-100) instead of emitting
# the garbled characters it tends to guess for diagram/figure regions.
OCR_LOCAL_MIN_WORD_CONFIDENCE=45
OCR_VISION_MODEL=google/gemini-2.5-flash
OCR_MIN_TEXT_SCORE=65
# Final safety net: a page's best-effort text (even after OCR) is dropped from
# the book entirely if its quality score is still below this, rather than
# showing garbled evidence to users.
OCR_DROP_BELOW_SCORE=30
OCR_RENDER_SCALE=2
OCR_MAX_PAGES=600
# Parallelism: OCR pages in flight (global) and books processed at once.
OCR_CONCURRENCY=6
PROCESSING_CONCURRENCY=2
OCR_MAX_OUTPUT_TOKENS=4096
ATLAS_VECTOR_INDEX_NAME=chunk_embedding_vector_index
VECTOR_CANDIDATE_MAX=300
VECTOR_NUM_CANDIDATES_MULTIPLIER=20
PDF_STORAGE_DIR=storage/pdfs
# Blob storage for uploaded PDFs + receipts: local (disk) | gridfs (MongoDB) | s3.
# Use gridfs to keep blobs in the cloud so they survive ephemeral-disk deploys.
STORAGE_DRIVER=gridfs
UPLOAD_MAX_MB=25
UPLOAD_MAX_FILES=10
# Zip-bomb guard for EPUB/DOCX uploads: max total decompressed size (all zip entries combined).
INGESTION_MAX_DECOMPRESSED_MB=500

# OMP (Open Monograph Press) integration
OMP_BASE_URL=http://localhost:8091
OMP_CONTEXT_PATH=index
# Generate in OMP: admin Profile → API Key
OMP_API_TOKEN=
# Encrypts the per-user OMP password we store (AES-256-GCM). Use a long random value.
OMP_USER_SECRET=
# Shared secret for one-time SSO login tokens; MUST match aradobot_sso_secret in OMP config.
OMP_SSO_SECRET=
# Default ISO country for OMP author registration when not collected in aradobot.
OMP_DEFAULT_COUNTRY=EG
# Push processed books into OMP as submissions (true/false).
OMP_PUSH_ENABLED=true
# OMP genre id for the uploaded manuscript file (1 = first/manuscript genre).
OMP_SUBMISSION_GENRE_ID=1

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
